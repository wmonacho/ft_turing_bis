{
    "name": "palindrome_detector",
    "alphabet": ["0", "1", ".", "y", "n", "x"],
    "blank": ".",
    "states": ["checkfirst", "firstone", "firstzero", "writeresult", "islastzero", "islastone", "endno", "endyes", "returnbegin", "checknewfirst", "HALT"],
    "initial": "checkfirst",
    "finals": ["HALT"],
    "transitions": {
        "writeresult": [
            { "read" : "0", "to_state": "HALT", "write": ".", "action": "RIGHT"},
            { "read" : "1", "to_state": "HALT", "write": ".", "action": "RIGHT"},
            { "read" : ".", "to_state": "HALT" , "write": ".", "action": "RIGHT" },
            { "read" : "y", "to_state": "HALT" , "write": ".", "action": "RIGHT" },
            { "read" : "n", "to_state": "HALT" , "write": ".", "action": "RIGHT" }
        ],
        "endno": [
            { "read" : "0", "to_state": "endno", "write": "0", "action": "RIGHT"},
            { "read" : "1", "to_state": "endno", "write": "1", "action": "RIGHT"},
            { "read" : "y", "to_state": "endno" , "write": ".", "action": "RIGHT" },
            { "read" : "n", "to_state": "endno" , "write": ".", "action": "RIGHT" },
            { "read" : "x", "to_state": "endno" , "write": "x", "action": "RIGHT" },

            { "read" : ".", "to_state": "writeresult" , "write": "n", "action": "RIGHT" }
        ],
        "endyes": [
            { "read" : "0", "to_state": "endyes", "write": "0", "action": "RIGHT"},
            { "read" : "1", "to_state": "endyes", "write": "1", "action": "RIGHT"},
            { "read" : "y", "to_state": "endyes" , "write": ".", "action": "RIGHT" },
            { "read" : "n", "to_state": "endyes" , "write": ".", "action": "RIGHT" },
            { "read" : "x", "to_state": "endyes" , "write": "x", "action": "RIGHT" },

            { "read" : ".", "to_state": "writeresult" , "write": "y", "action": "RIGHT" }
        ],
        "checkfirst": [
            { "read": "0", "to_state": "firstzero", "write": "x", "action": "RIGHT" },
            { "read": "1", "to_state": "firstone", "write": "x", "action": "RIGHT" },
            { "read": "x", "to_state": "endno", "write": "x", "action": "RIGHT" }
        ],
        "checknewfirst": [
            { "read": "0", "to_state": "firstzero", "write": "x", "action": "RIGHT" },
            { "read": "1", "to_state": "firstone", "write": "x", "action": "RIGHT" },
            { "read": "x", "to_state": "checknewfirst", "write": "x", "action": "RIGHT" },
            { "read": ".", "to_state": "writeresult", "write": "y", "action": "RIGHT" }
        ],
        "firstzero": [
            { "read": "0", "to_state": "firstzero", "write": "0", "action": "RIGHT" },
            { "read": "1", "to_state": "firstzero", "write": "1", "action": "RIGHT" },
            { "read": ".", "to_state": "islastzero", "write": ".", "action": "LEFT" },
            { "read": "x", "to_state": "islastzero", "write": "x", "action": "LEFT" }
        ],
        "islastzero": [
            { "read": "0", "to_state": "returnbegin", "write": "x", "action": "LEFT" },
            { "read": "x", "to_state": "endyes", "write": "x", "action": "RIGHT" },
            { "read": "1", "to_state": "endno", "write": "1", "action": "RIGHT" }
        ],
        "returnbegin": [
            { "read": "0", "to_state": "returnbegin", "write": "0", "action": "LEFT" },
            { "read": "1", "to_state": "returnbegin", "write": "1", "action": "LEFT" },
            { "read": "x", "to_state": "returnbegin", "write": "x", "action": "LEFT" },
            { "read": ".", "to_state": "checknewfirst", "write": ".", "action": "RIGHT" }
        ],
        "firstone": [
            { "read": "0", "to_state": "firstone", "write": "0", "action": "RIGHT" },
            { "read": "1", "to_state": "firstone", "write": "1", "action": "RIGHT" },
            { "read": "x", "to_state": "islastone", "write": "x", "action": "LEFT" },
            { "read": ".", "to_state": "islastone", "write": ".", "action": "LEFT" }
        ],
        "islastone": [
            { "read": "1", "to_state": "returnbegin", "write": "x", "action": "LEFT" },
            { "read": "x", "to_state": "endyes", "write": "x", "action": "RIGHT" },
            { "read": "0", "to_state": "endno", "write": "0", "action": "RIGHT" }
        ]
    }
